# Kopieer naar `.env` en pas aan.
# Privacy-filter sidecar (openai/privacy-filter op Hugging Face)
PII_PRIVACY_FILTER_URL=http://127.0.0.1:8091

# Optioneel: langere timeout voor eerste model-load
# PII_PRIVACY_FILTER_TIMEOUT_SECS=180

# Optioneel: ResearchExpert HTTP-preview (stub als uit)
MESH_RESEARCH_HTTP=1
